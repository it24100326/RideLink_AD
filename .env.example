# =============================================================================
# RideLink Microservices Platform - Environment Configuration Template
# =============================================================================
# COPY this file to .env and replace the placeholder values.
# NEVER commit your actual .env file or credentials to Git! (Protected by .gitignore)

# -----------------------------------------------------------------------------
# MongoDB Atlas Configuration
# -----------------------------------------------------------------------------
# The hostname of your Atlas cluster (from your Atlas connection string)
MONGODB_CLUSTER_HOST=cluster0.0ir2l9y.mongodb.net

# Database authentication credentials
MONGODB_USER=ashfak
MONGODB_PASSWORD=Ashfak123

# -----------------------------------------------------------------------------
# Service Specific MongoDB URIs (Automatically constructed or customized)
# -----------------------------------------------------------------------------
ACCOUNT_MONGODB_URI=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_CLUSTER_HOST}/ridelink_account_db?retryWrites=true&w=majority&appName=Cluster0
DRIVER_MONGODB_URI=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_CLUSTER_HOST}/ridelink_driver_db?retryWrites=true&w=majority&appName=Cluster0
RIDE_MONGODB_URI=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_CLUSTER_HOST}/ridelink_ride_db?retryWrites=true&w=majority&appName=Cluster0
PAYMENT_MONGODB_URI=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_CLUSTER_HOST}/ridelink_payment_db?retryWrites=true&w=majority&appName=Cluster0

# -----------------------------------------------------------------------------
# Downstream Microservices Base URLs (Default local ports)
# -----------------------------------------------------------------------------
DRIVER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8084

# -----------------------------------------------------------------------------
# JWT Security
# -----------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
